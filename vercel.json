{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index?__route=health"
    },
    {
      "source": "/api/check",
      "destination": "/api/index?__route=check"
    },
    {
      "source": "/api/snp-check",
      "destination": "/api/index?__route=snp-check"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
